{
  "extends": "@dify/tsconfig/nextjs.json",
  "compilerOptions": {
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "~@/*": ["./*"]
    },
    "resolveJsonModule": true,
    "types": ["vite-plus/test/globals", "vite-plus/test/matchers", "node"],
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
