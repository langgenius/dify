{
  "name": "dify-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "node ./scripts/run-cucumber.ts",
    "e2e:accessibility": "pnpm run e2e:accessibility:aa",
    "e2e:accessibility:a": "node ./scripts/run-cucumber.ts --full -- --tags \"@axe and @wcag-a\"",
    "e2e:accessibility:aa": "node ./scripts/run-cucumber.ts --full -- --tags \"@axe and @wcag-aa\"",
    "e2e:external": "node ./scripts/run-external-runtime.ts",
    "e2e:external:prepare": "node ./scripts/run-cucumber.ts --seed-only --profile external-runtime",
    "e2e:full": "node ./scripts/run-cucumber.ts --full",
    "e2e:full:headed": "node ./scripts/run-cucumber.ts --full --headed",
    "e2e:headed": "node ./scripts/run-cucumber.ts --headed",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "e2e:install:ci": "playwright install --with-deps --only-shell chromium webkit",
    "e2e:install:ci:chromium": "playwright install --with-deps --only-shell chromium",
    "e2e:install:ci:webkit": "playwright install --with-deps --only-shell webkit",
    "e2e:middleware:down": "node ./scripts/setup.ts middleware-down",
    "e2e:middleware:up": "node ./scripts/setup.ts middleware-up",
    "e2e:post-merge": "node ./scripts/run-post-merge.ts",
    "e2e:post-merge:prepare": "node ./scripts/run-cucumber.ts --seed-only --profile post-merge",
    "e2e:prepared": "node ./scripts/run-prepared.ts",
    "e2e:prepared:prepare": "node ./scripts/run-cucumber.ts --seed-only --profile prepared",
    "e2e:reset": "node ./scripts/setup.ts reset",
    "e2e:web:build": "node ./scripts/setup.ts web-build",
    "seed": "node ./scripts/run-cucumber.ts --seed-only",
    "test:unit": "vp test run",
    "type-check": "tsc"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@cucumber/cucumber": "catalog:",
    "@dify/contracts": "workspace:*",
    "@dify/tsconfig": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "@playwright/test": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eventsource-parser": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  }
}
