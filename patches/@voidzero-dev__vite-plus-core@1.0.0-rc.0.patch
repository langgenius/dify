+import { readdir, stat } from "node:fs/promises";
+import { resolve } from "node:path";
+import { setTimeout as sleep } from "node:timers/promises";
+
+// The native writer has a fixed 30s close timeout. Let its queue drain before
+// closing large analysis builds. Native close still performs the final flush
+// and acknowledgement; a quiet file alone is not treated as a completed session.
+export async function waitForDevtoolsDrain(cwd, sessionId, {
+  timeout = 300_000,
+  quietPeriod = 2_000,
+  pollInterval = 250,
+} = {}) {
+  const file = resolve(cwd, "node_modules/.rolldown", sessionId, "logs.json");
+  const started = performance.now();
+  let lastChange = started;
+  let previous;
+  while (performance.now() - started < timeout) {
+    let current;
+    try {
+      const info = await stat(file);
+      current = `${info.size}:${info.mtimeMs}`;
+    } catch (error) {
+      if (error.code !== "ENOENT") throw error;
+    }
+    const now = performance.now();
+    if (current === undefined || current !== previous) {
+      previous = current;
+      lastChange = now;
+    } else if (now - lastChange >= quietPeriod) {
+      return;
+    }
+    await sleep(pollInterval);
+  }
+  throw new Error(`DevTools logs did not settle within ${timeout}ms: ${file}`);
+}
+
+export async function snapshotDevtoolsLogs(cwd) {
+  const root = resolve(cwd, "node_modules/.rolldown");
+  let entries;
+  try { entries = await readdir(root, { withFileTypes: true }); }
+  catch (error) { if (error.code === "ENOENT") return new Map(); throw error; }
+  const files = await Promise.all(entries.filter(entry => entry.isDirectory()).map(async entry => {
+    try {
+      const info = await stat(resolve(root, entry.name, "logs.json"));
+      return [entry.name, `${info.size}:${info.mtimeMs}`];
+    } catch (error) { if (error.code === "ENOENT") return [entry.name, undefined]; throw error; }
+  }));
+  return new Map(files);
+}
