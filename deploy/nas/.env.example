# DiFly NAS 部署配置
# 复制为 .env 后修改 NAS_HOST 和密码

# ===== 必填：改成你的 NAS 局域网 IP =====
NAS_HOST=192.168.1.100

# ===== 访问地址（端口 8090）=====
CONSOLE_API_URL=http://192.168.1.100:8090
CONSOLE_WEB_URL=http://192.168.1.100:8090
SERVICE_API_URL=http://192.168.1.100:8090
APP_API_URL=http://192.168.1.100:8090
APP_WEB_URL=http://192.168.1.100:8090
FILES_URL=http://192.168.1.100:8090
NEXT_PUBLIC_SOCKET_URL=ws://192.168.1.100:8090

# ===== 端口（对外 8090，与 Nextcloud 习惯一致）=====
EXPOSE_NGINX_PORT=8090
NGINX_HTTPS_ENABLED=false

# ===== 安全（部署前务必修改）=====
INIT_PASSWORD=ChangeMe123!
DB_PASSWORD=difly_db_123456
REDIS_PASSWORD=difly_redis_123456

# ===== NAS 资源优化（内存 < 8GB 时建议保留）=====
SERVER_WORKER_AMOUNT=1
CELERY_WORKER_AMOUNT=2
COMPOSE_WORKER_HEALTHCHECK_DISABLED=true

# 关闭协作模式可省内存（工作流多人实时协作）
ENABLE_COLLABORATION_MODE=false
COMPOSE_PROFILES=postgresql,weaviate

# ===== 数据存储路径（相对 deploy/nas 目录）=====
OPENDAL_FS_ROOT=storage
