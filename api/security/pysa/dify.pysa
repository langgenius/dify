def werkzeug.wrappers.request.Request.get_json() -> TaintSource[UserControlled]: ...

ModelQuery(
    name = "dify_flask_restx_path_parameters",
    find = "methods",
    where = [
        name.matches("^(get|post|put|patch|delete|head|options)$"),
        cls.fully_qualified_name.matches("^controllers\."),
        cls.name.matches("(Api|Resource)$")
    ],
    model = [
        Parameters(
            TaintSource[UserControlled],
            where = [
                Not(name.equals("self")),
                AnyOf(
                    name.matches("(^id$|_id$|_ids$|_code$|^code$|^filename$|^path$)"),
                    type_annotation.fully_qualified.matches("^(builtins\.)?(str|int|float|bool)$"),
                    type_annotation.fully_qualified.equals("uuid.UUID")
                )
            ]
        )
    ]
)

# The SSRF-safe owners remain sinks so the analysis can identify caller paths
# which let untrusted data select an outbound destination. Their responses are
# external data sources regardless of whether the network policy allows them.
def core.helper.ssrf_proxy.make_request(
    method,
    url: TaintSink[HTTPClientRequest],
    max_retries,
    stream_response,
    **kwargs,
) -> TaintSource[DataFromInternet]: ...

def core.helper.ssrf_proxy.get(url: TaintSink[HTTPClientRequest], max_retries, **kwargs) -> TaintSource[DataFromInternet]: ...
def core.helper.ssrf_proxy.post(url: TaintSink[HTTPClientRequest], max_retries, **kwargs) -> TaintSource[DataFromInternet]: ...
def core.helper.ssrf_proxy.put(url: TaintSink[HTTPClientRequest], max_retries, **kwargs) -> TaintSource[DataFromInternet]: ...
def core.helper.ssrf_proxy.patch(url: TaintSink[HTTPClientRequest], max_retries, **kwargs) -> TaintSource[DataFromInternet]: ...
def core.helper.ssrf_proxy.delete(url: TaintSink[HTTPClientRequest], max_retries, **kwargs) -> TaintSource[DataFromInternet]: ...
def core.helper.ssrf_proxy.head(url: TaintSink[HTTPClientRequest], max_retries, **kwargs) -> TaintSource[DataFromInternet]: ...

def core.file.remote_fetcher.make_request(
    method,
    url: TaintSink[HTTPClientRequest],
    max_retries,
    **kwargs,
) -> TaintSource[DataFromInternet]: ...

# Custom tools, the plugin daemon, and MCP servers cross process or network
# trust boundaries. Model their high-level return values so serialization and
# dynamically typed protocol objects cannot break a source-to-sink trace.
