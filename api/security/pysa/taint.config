{
  "sources": [
    {
      "name": "UserControlled",
      "comment": "Data controlled by an inbound HTTP or MCP client"
    },
    {
      "name": "DataFromInternet",
      "comment": "Data returned by an HTTP service, plugin, tool, or MCP server"
    }
  ],
  "sinks": [
    {
      "name": "RemoteCodeExecution",
      "comment": "Source code evaluated by the Python runtime or Dify sandbox"
    },
    {
      "name": "CommandExecution",
      "comment": "Arguments, environment, or executable passed to a process"
    },
    {
      "name": "DynamicImport",
      "comment": "A module name resolved dynamically"
    },
    {
      "name": "UnsafeDeserialization",
      "comment": "Data decoded by a deserializer capable of object construction or code execution"
    },
    {
      "name": "SQL",
      "comment": "A raw SQL statement sent to a database driver"
    },
    {
      "name": "HTTPClientRequest",
      "comment": "A URL passed to an outbound HTTP client"
    },
    {
      "name": "FileSystem",
      "comment": "A path used for a local filesystem read, write, or mutation"
    },
    {
      "name": "XSS",
      "comment": "Unescaped content written to an HTTP response"
    },
    {
      "name": "Redirect",
      "comment": "A URL used as an HTTP redirect target"
    },
    {
      "name": "ServerSideTemplateInjection",
      "comment": "A string interpreted as a server-side template"
    }
  ],
  "features": [],
  "rules": [
    {
      "name": "Untrusted data to code execution",
      "code": 5001,
      "sources": ["UserControlled", "DataFromInternet"],
      "sinks": ["RemoteCodeExecution"],
      "message_format": "Data from [{$sources}] may reach [{$sinks}]"
    },
    {
      "name": "SQL injection",
      "code": 5005,
      "sources": ["UserControlled", "DataFromInternet"],
      "sinks": ["SQL"],
      "message_format": "Data from [{$sources}] may reach [{$sinks}]"
    },
    {
      "name": "Cross-site scripting",
      "code": 5008,
      "sources": ["UserControlled", "DataFromInternet"],
      "sinks": ["XSS"],
      "message_format": "Data from [{$sources}] may reach [{$sinks}]"
    },
    {
      "name": "Arbitrary filesystem access",
      "code": 5011,
      "sources": ["UserControlled", "DataFromInternet"],
      "sinks": ["FileSystem"],
      "message_format": "Data from [{$sources}] may reach [{$sinks}]"
    },
    {
      "name": "Server-side request forgery",
      "code": 5012,
      "sources": ["UserControlled", "DataFromInternet"],
      "sinks": ["HTTPClientRequest"],
      "message_format": "Data from [{$sources}] may reach [{$sinks}]"
    },
    {
      "name": "Open redirect",
      "code": 5018,
      "sources": ["UserControlled", "DataFromInternet"],
      "sinks": ["Redirect"],
      "message_format": "Data from [{$sources}] may reach [{$sinks}]"
    },
    {
      "name": "Dynamic import injection",
      "code": 6064,
      "sources": ["UserControlled", "DataFromInternet"],
      "sinks": ["DynamicImport"],
      "message_format": "Data from [{$sources}] may reach [{$sinks}]"
    },
    {
      "name": "Command injection",
      "code": 6065,
      "sources": ["UserControlled", "DataFromInternet"],
      "sinks": ["CommandExecution"],
      "message_format": "Data from [{$sources}] may reach [{$sinks}]"
    },
    {
      "name": "Unsafe deserialization",
      "code": 6066,
      "sources": ["UserControlled", "DataFromInternet"],
      "sinks": ["UnsafeDeserialization"],
      "message_format": "Data from [{$sources}] may reach [{$sinks}]"
    },
    {
      "name": "Server-side template injection",
      "code": 6073,
      "sources": ["UserControlled", "DataFromInternet"],
      "sinks": ["ServerSideTemplateInjection"],
      "message_format": "Data from [{$sources}] may reach [{$sinks}]"
    }
  ]
}
