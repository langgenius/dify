      ],
      "title": "ActivateMigrationPayload",
      "type": "object"
    },
    "ActivateRequest": {
      "$ref": "#/$defs/ActivateMigrationPayload"
    },
    "Window": {
      "$ref": "#/$defs/MigrationWindow"
    },
    "MigrationOperationSummary": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "preparing",
            "prepared",
            "claimed",
            "granting",
            "activating",
            "active",
            "blocked",
            "cancelled"
          ],
          "title": "Phase",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "enum": [
            "legacy_deferred",
            "tokener"
          ],
          "type": "string"
        },
        "cycle_key": {
          "title": "Cycle Key",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "manifest_hash": {
          "title": "Manifest Hash",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "error_code": {
          "title": "Error Code",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "route_epoch": {
