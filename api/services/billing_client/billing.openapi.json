          "curr_page",
          "has_next"
        ]
      },
      "BatchGetSubscriptionPlanReply": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/SubscriptionPlanItem"
            }
          }
        },
        "description": "Batch get subscription plan reply",
        "required": [
