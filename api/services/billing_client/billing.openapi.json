      "BatchGetSubscriptionPlanReq": {
        "type": "object",
        "properties": {
          "tenant_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "description": "Batch get subscription plan request",
        "required": [
          "tenant_ids"
        ]
      },
      "BillingSubscriptionPlan": {
        "type": "object",
        "properties": {
          "plan": {
            "enum": [
              "sandbox",
              "professional",
              "team"
            ],
            "type": "string"
          },
          "interval": {
            "enum": [
              "",
              "month",
              "year"
            ],
            "type": "string"
          },
          "education": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "cancel_at_period_end": {
            "type": "boolean"
          },
          "paid_period_end": {
            "type": "string",
            "format": "int64"
          }
        },
        "description": "Subscription plan and billing cycle info",
        "required": [
          "plan",
          "interval",
          "education",
          "status",
          "cancel_at_period_end",
          "paid_period_end"
        ]
      },
      "CreateEducationIdentityReply": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "CreateEducationIdentityReq": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string"
          },
          "curr_tenant_id": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "curr_tenant_id",
          "institution",
          "role",
          "token"
        ]
      },
      "DownloadComplianceDocumentReply": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      },
      "DownloadComplianceDocumentReq": {
        "type": "object",
        "properties": {
          "doc_name": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "ip_address": {
            "type": "string"
          },
          "device_info": {
            "type": "string"
          }
        },
        "required": [
          "doc_name",
          "account_id",
          "tenant_id",
          "ip_address",
          "device_info"
        ]
      },
      "GetEducationIdentityStatusReply": {
        "type": "object",
        "properties": {
          "result": {
            "type": "boolean",
            "description": "True when the account has an education identity that has not expired yet. False when it has\n none or its latest identity has expired."
          },
          "is_student": {
            "type": "boolean",
            "description": "Always equal to `result`."
          },
          "expire_at": {
            "type": "string",
            "description": "Expiry of the account's latest education identity, as an RFC 3339 UTC timestamp\n (for example `2027-10-30T08:00:00Z`). `1997-01-01T00:00:00Z` when the account has no education identity.",
            "format": "date-time"
          },
          "allow_refresh": {
            "type": "boolean",
            "description": "True when the latest education identity expires within the configured number of refresh days\n before or after now. False when the account has no education identity."
          }
        },
        "required": [
          "result",
          "is_student",
          "expire_at",
          "allow_refresh"
        ]
      },
      "GetInvoicesReply": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      },
      "GetKnowledgeRateLimitReply": {
        "type": "object",
        "properties": {
          "subscription_plan": {
            "enum": [
              "sandbox",
              "professional",
              "team"
            ],
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "subscription_plan",
          "limit"
        ]
      },
      "GetModelProviderPaymentLinkReply": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      },
      "GetSubscriptionInfoReply": {
        "required": [
          "enabled",
          "subscription",
          "members",
          "apps",
          "vector_space",
          "knowledge_rate_limit",
          "documents_upload_quota",
          "annotation_quota_limit",
          "docs_processing",
          "can_replace_logo",
          "model_load_balancing_enabled",
          "knowledge_pipeline_publish_enabled",
          "next_credit_reset_date"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "subscription": {
            "$ref": "#/components/schemas/BillingSubscriptionPlan"
          },
          "members": {
            "$ref": "#/components/schemas/SubscriptionQuota"
          },
          "apps": {
            "$ref": "#/components/schemas/SubscriptionQuota"
          },
          "vector_space": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VectorSpaceQuota"
              }
            ],
            "nullable": true
          },
          "knowledge_rate_limit": {
            "$ref": "#/components/schemas/KnowledgeRateLimit"
          },
          "documents_upload_quota": {
            "$ref": "#/components/schemas/SubscriptionQuota"
          },
          "annotation_quota_limit": {
            "$ref": "#/components/schemas/SubscriptionQuota"
          },
          "docs_processing": {
            "enum": [
              "standard",
              "priority",
              "top-priority"
            ],
            "type": "string"
          },
          "can_replace_logo": {
            "type": "boolean"
          },
          "model_load_balancing_enabled": {
            "type": "boolean"
          },
          "knowledge_pipeline_publish_enabled": {
            "type": "boolean"
          },
          "next_credit_reset_date": {
            "type": "string",
            "format": "int64"
          }
        },
        "description": "Get subscription info reply"
      },
      "GetSubscriptionPaymentLinkReply": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "description": "Get subscription payment link reply",
        "required": [
          "url"
        ]
      },
      "KnowledgeRateLimit": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string",
            "format": "int64"
          },
          "limit": {
            "type": "string",
            "format": "int64"
          }
        },
        "description": "Knowledge rate limit (requests per minute)\n NOTE: size is retained for structural consistency but is not consumed by dify.\n Implementation should populate 0 for paid users.",
        "required": [
          "size",
          "limit"
        ]
      },
      "ListSubscriptionCleanupWhitelistReply": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubscriptionCleanupWhitelist"
            }
          }
        },
        "description": "List subscription cleanup whitelist reply",
        "required": [
          "data"
        ]
      },
      "QuotaCommitReply": {
        "type": "object",
        "properties": {
          "available": {
            "type": "string",
            "format": "int64"
          },
          "reserved": {
            "type": "string",
            "format": "int64"
          },
          "refunded": {
            "type": "string",
            "format": "int64"
          }
        },
        "required": [
          "available",
          "reserved",
          "refunded"
        ]
      },
      "QuotaCommitReq": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "feature_key": {
            "type": "string"
          },
          "reservation_id": {
            "type": "string"
          },
          "actual_amount": {
            "type": "string",
            "format": "int64"
          },
          "meta": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "bucket": {
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "feature_key",
          "reservation_id",
          "actual_amount",
          "meta",
          "bucket"
