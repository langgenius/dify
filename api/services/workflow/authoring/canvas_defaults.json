{
  "agent": {
    "tool_node_version": "2"
  },
  "agent-v2": {
    "agent_binding": {
      "binding_type": "inline_agent"
    },
    "agent_node_kind": "dify_agent"
  },
  "answer": {},
  "assigner": {},
  "code": {
    "code_language": "python3"
  },
  "datasource": {},
  "datasource-empty": {},
  "document-extractor": {
    "is_array_file": false
  },
  "end": {},
  "http-request": {
    "authorization": {
      "type": "no-auth"
    },
    "body": {
      "type": "none"
    },
    "method": "get",
    "retry_config": {
      "max_retries": 3,
      "retry_enabled": true,
      "retry_interval": 100
    },
    "ssl_verify": true,
    "timeout": {
      "max_connect_timeout": 0,
      "max_read_timeout": 0,
      "max_write_timeout": 0
    }
  },
  "human-input": {
    "timeout": 3,
    "timeout_unit": "day"
  },
  "human-input-v2": {
    "debug_mode": {
      "enabled": false
    },
    "timeout": 36,
    "timeout_unit": "hour"
  },
  "if-else": {
    "cases": [
      {
        "case_id": "true",
        "logical_operator": "and"
      }
    ]
  },
  "iteration": {
    "error_handle_mode": "terminated",
    "flatten_output": true,
    "is_parallel": false,
    "parallel_nums": 10
  },
  "iteration-start": {},
  "knowledge-index": {
    "keyword_number": 10,
    "retrieval_model": {
      "score_threshold": 0.5,
      "score_threshold_enabled": false,
      "top_k": 3
    }
  },
  "knowledge-retrieval": {
    "multiple_retrieval_config": {
      "reranking_enable": false,
      "top_k": 4
    },
    "retrieval_mode": "multiple"
  },
  "knowledge-retrieval-v2": {
    "metadata_filtering_mode": "disabled",
    "top_n": 10
  },
  "list-operator": {
    "extract_by": {
      "enabled": false,
      "serial": "1"
    },
    "filter_by": {
      "enabled": false
    },
    "limit": {
      "enabled": false,
      "size": 10
    },
    "order_by": {
      "enabled": false,
      "value": "asc"
    }
  },
  "llm": {
    "context": {
      "enabled": false
    },
    "model": {
      "completion_params": {
        "temperature": 0.7
      },
      "mode": "chat"
    },
    "prompt_template": [
      {
        "role": "system"
      }
    ],
    "vision": {
      "enabled": false
    }
  },
  "loop": {
    "logical_operator": "and",
    "loop_count": 10
  },
  "loop-end": {},
  "loop-start": {},
  "parameter-extractor": {
    "model": {
      "completion_params": {
        "temperature": 0.7
      },
      "mode": "chat"
    },
    "reasoning_mode": "prompt",
    "vision": {
      "enabled": false
    }
  },
  "question-classifier": {
    "classes": [
      {
        "id": "1",
        "label": "CLASS 1"
      },
      {
        "id": "2",
        "label": "CLASS 2"
      }
    ],
    "model": {
      "completion_params": {
        "temperature": 0.7
      },
      "mode": "chat"
    },
    "vision": {
      "enabled": false
    }
  },
  "start": {},
  "start-placeholder": {},
  "template-transform": {},
  "tool": {
    "tool_node_version": "2"
  },
  "trigger-plugin": {},
  "trigger-schedule": {
    "frequency": "daily",
    "mode": "visual",
    "visual_config": {
      "monthly_days": [
        1
      ],
      "on_minute": 0,
      "time": "12:00 AM",
      "weekdays": [
        "sun"
      ]
    }
  },
  "trigger-webhook": {
    "async_mode": true,
    "content_type": "application/json",
    "method": "POST",
    "status_code": 200,
    "variables": [
      {
        "label": "raw",
        "required": true,
        "value_type": "object",
        "variable": "_webhook_raw"
      }
    ]
  },
  "variable-aggregator": {
    "output_type": "any"
  }
}
