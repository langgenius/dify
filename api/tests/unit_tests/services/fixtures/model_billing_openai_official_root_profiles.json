            },
            "type": "float",
            "help": {
              "zh_Hans": "对文本中已有的标记的对数概率施加惩罚。",
              "en_US": "Applies a penalty to the log-probability of tokens already in the text."
            },
            "required": false,
            "default": 0,
            "min": 0,
            "max": 1,
            "precision": 2,
            "options": []
          },
