# Optional credentials for Human Input IM provider live tests.
# Copy to .env.local, fill only the providers being tested, then export before pytest:
# set -a; source api/tests/e2e_tests/containers/.env.local; set +a
# Tests skip when their required credentials are absent. Do not commit credentials.
# These variables are test inputs, not Dify deployment settings.

# Optional container fixture image override.
# DIFY_SANDBOX_TEST_IMAGE=langgenius/dify-sandbox:0.2.14

# Feishu / Lark: all five settings are required for the live card-flow test.
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=
# FEISHU_TEST_RECIPIENT_ID=

# Slack: Socket Mode credentials; the recipient is required only for messaging tests.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
# SLACK_APP_SOCKET_TOKEN=
# SLACK_TEST_RECIPIENT_ID=

# DingTalk: the recipient is required only for messaging tests.
# DINGTALK_CORP_ID=
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
# DINGTALK_TEST_RECIPIENT_ID=

# Microsoft Teams: the recipient is required only for messaging tests.
# MS_TEAMS_TENANT_ID=
# MS_TEAMS_CLIENT_ID=
# MS_TEAMS_CLIENT_SECRET=
# MS_TEAMS_TEST_RECIPIENT_ID=

# WeCom: the recipient is required only for messaging tests.
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_SECRET=
# WECOM_TEST_RECIPIENT_ID=

# Optional Redis connection for the DingTalk token-cache test; unset skips the test.
# REDIS_URL=
