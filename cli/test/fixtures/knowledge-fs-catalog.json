{
  "ops": {
    "knowledge_fs.ls": {
      "summary": "List an Agent Knowledge Base directory (ls)",
      "method": "GET",
      "path": "/openapi/v1/workspaces/{workspace_id}/knowledge-fs/knowledge-spaces/{knowledge_space_id}/fs:ls",
      "kind": "object",
      "input": {
        "type": "object",
        "properties": {
          "knowledge_space_id": {
            "type": "string"
          },
          "workspace_id": {
            "type": "string"
          },
          "path": {
            "description": "Canonical Agent Knowledge Base virtual path under /sources, /knowledge, /evidence, or /workspaces.",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^/(?:sources|knowledge|evidence|workspaces)(?:/[^/\\s]+)*$",
            "title": "Path",
            "type": "string"
          },
          "consistency_class": {
            "anyOf": [
              {
                "enum": [
                  "path-consistent",
                  "snapshot-consistent",
                  "cache-consistent",
                  "eventual-preview"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional Agent Knowledge Base read-consistency policy."
          },
          "page_size": {
            "default": 20,
            "description": "Maximum number of results to return (1-100).",
            "maximum": 100,
            "minimum": 1,
            "title": "Page Size",
            "type": "integer"
          },
          "page_token": {
            "anyOf": [
              {
                "maxLength": 8192,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Opaque continuation token returned as next_page_token. Repeat the same query without inspecting the token.",
            "title": "Page Token"
          }
        },
        "required": ["knowledge_space_id", "workspace_id", "path"]
      },
      "bind": {
        "knowledge_space_id": "path",
        "workspace_id": "path",
        "path": "query",
        "consistency_class": "query",
        "page_size": "query",
        "page_token": "query"
      },
      "internal": false,
      "deprecated": false,
      "examples": [
        {
          "title": "List a knowledge directory",
          "input": {
            "workspace_id": "<workspace_id>",
            "knowledge_space_id": "<knowledge_space_id>",
            "path": "/knowledge"
          }
        }
      ]
    },
