    "knowledge_fs.diff": {
      "summary": "Compare two Agent Knowledge Base entries (diff)",
      "method": "POST",
      "path": "/openapi/v1/workspaces/{workspace_id}/knowledge-fs/knowledge-spaces/{knowledge_space_id}/fs:diff",
      "kind": "object",
      "input": {
        "type": "object",
        "properties": {
          "knowledge_space_id": {
            "type": "string"
          },
          "workspace_id": {
            "type": "string"
          },
          "old_path": {
            "description": "Canonical path of the baseline entry.",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^/(?:sources|knowledge|evidence|workspaces)(?:/[^/\\s]+)*$",
            "title": "Old Path",
            "type": "string"
          },
          "new_path": {
            "description": "Canonical path of the entry to compare.",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^/(?:sources|knowledge|evidence|workspaces)(?:/[^/\\s]+)*$",
            "title": "New Path",
            "type": "string"
          },
          "mode": {
            "anyOf": [
              {
                "enum": ["line", "word"],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Comparison granularity.",
            "title": "Mode"
          },
          "include_semantic_summary": {
            "default": false,
            "description": "Whether to generate a bounded semantic change summary. This can consume model quota.",
            "title": "Include Semantic Summary",
            "type": "boolean"
          },
          "consistency_class": {
            "anyOf": [
              {
                "enum": [
                  "path-consistent",
                  "snapshot-consistent",
                  "cache-consistent",
                  "eventual-preview"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional Agent Knowledge Base read-consistency policy."
          }
        },
        "required": ["knowledge_space_id", "workspace_id", "old_path", "new_path"]
      },
      "bind": {
        "knowledge_space_id": "path",
        "workspace_id": "path",
        "old_path": "body",
        "new_path": "body",
        "mode": "body",
        "include_semantic_summary": "body",
        "consistency_class": "body"
      },
      "internal": false,
      "deprecated": false,
      "examples": [
        {
          "title": "Compare two knowledge entries",
          "input": {
            "workspace_id": "<workspace_id>",
            "knowledge_space_id": "<knowledge_space_id>",
            "old_path": "/knowledge/guide-v1",
            "new_path": "/knowledge/guide-v2"
          }
        }
      ]
    },
