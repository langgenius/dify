        "query": "body",
        "workflow_id": "body",
        "workspace_id": "body"
      },
      "deprecated": false,
      "input": {
        "properties": {
          "app_id": {
            "type": "string"
          },
          "attachments": {
            "anyOf": [
              {
                "items": {
                  "format": "binary",
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Local files attached to the run itself (the app's `sys.files`), not to a variable",
            "title": "Attachments"
          },
          "auto_generate_name": {
            "default": true,
            "description": "Let the server name a new conversation",
            "title": "Auto Generate Name",
            "type": "boolean"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Continue an existing conversation",
            "title": "Conversation Id"
          },
          "files": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "format": "binary",
                      "type": "string"
                    },
                    {
                      "items": {
                        "format": "binary",
                        "type": "string"
                      },
                      "type": "array"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Local files keyed by the app's file variable name; the server uploads each one and sets `inputs[<name>]`. Send a list (part name `files[<name>][]`) for a file-list variable",
            "title": "Files"
          },
          "inputs": {
            "additionalProperties": true,
            "description": "Variables declared by the app. The exact shape is per app: read `input_schema` from console_app.describe. A file variable takes a Dify file mapping (remote url or upload id) here, or a local file in `files`, not both.",
            "title": "Inputs",
            "type": "object"
          },
          "query": {
            "description": "User message",
            "title": "Query",
            "type": "string"
          },
          "workflow_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Pin a published workflow version",
            "title": "Workflow Id"
          },
          "workspace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Workspace that owns the app",
            "title": "Workspace Id"
          }
        },
        "required": ["app_id", "inputs", "query"],
        "type": "object"
      },
      "internal": false,
      "kind": "sse",
      "method": "POST",
      "path": "/openapi/v1/apps/{app_id}/advanced-chat:run",
      "summary": "Run an advanced-chat (chatflow) app; streams message and workflow events",
      "tags": ["console_app"]
