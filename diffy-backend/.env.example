# --- OpenAI ChatKit agents ---
OPENAI_API_KEY=sk-your-api-key-here
COOKIE_SECRET=change-this-to-a-random-secret-string
THREAD_RETENTION_DAYS=30

# --- Dify agents ---
# Defaults used when an agent has no dify_base_url / dify_api_key of its own.
# Self-hosted: https://dify.your-domain.com/v1   Cloud: https://api.dify.ai/v1
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=app-your-dify-app-key

# --- Server ---
PORT=3000
ADMIN_PASSWORD=change-this-to-a-secure-password

# Allow agents configured as a bare host ("localhost:4001", "example.com") to
# match any page on that host. Off by default — full URLs are preferred because
# they let one domain host several agents on different paths.
ENABLE_HOSTNAME_FALLBACK=false
