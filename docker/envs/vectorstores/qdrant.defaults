# Defaults for qdrant. Copy this file to qdrant.env to customize it.
# Edit the settings below in the copy; docker/.env takes precedence.
# Optional application settings are commented to retain their application defaults.

QDRANT_API_KEY=${QDRANT_API_KEY-difyai123456}

# Container file descriptor limits default to 524288 (soft and hard).
# Set QDRANT_NOFILE_SOFT and QDRANT_NOFILE_HARD in docker/.env to override them;
# Compose needs these settings before loading service env files.

# Dify vector client settings (API, workers and Beat)
QDRANT_URL=${QDRANT_URL-http://qdrant:6333}
# QDRANT_CLIENT_TIMEOUT=20
# QDRANT_GRPC_ENABLED=false
# QDRANT_GRPC_PORT=6334
# QDRANT_REPLICATION_FACTOR=1

# Container variable mapping; keep this expression unchanged in the copy.
QDRANT__SERVICE__API_KEY=${QDRANT_API_KEY-difyai123456}
