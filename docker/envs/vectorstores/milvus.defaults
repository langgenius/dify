# Defaults for Milvus. Copy this file to milvus.env to customize it.
# docker/.env takes precedence. Credentials authenticate to an existing Milvus user;
# change that user's password in Milvus before updating MILVUS_PASSWORD here.

MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY-minioadmin}
MINIO_SECRET_KEY=${MINIO_SECRET_KEY-minioadmin}
ETCD_ENDPOINTS=${ETCD_ENDPOINTS-etcd:2379}
MINIO_ADDRESS=${MINIO_ADDRESS-minio:9000}
ETCD_AUTO_COMPACTION_MODE=${ETCD_AUTO_COMPACTION_MODE-revision}
ETCD_AUTO_COMPACTION_RETENTION=${ETCD_AUTO_COMPACTION_RETENTION-1000}
ETCD_QUOTA_BACKEND_BYTES=${ETCD_QUOTA_BACKEND_BYTES-4294967296}
ETCD_SNAPSHOT_COUNT=${ETCD_SNAPSHOT_COUNT-50000}
MILVUS_AUTHORIZATION_ENABLED=${MILVUS_AUTHORIZATION_ENABLED-true}
# MILVUS_SECURE=false
# MILVUS_SERVER_PEM_PATH=
# MILVUS_SERVER_NAME=

# Dify vector client settings (API, workers and Beat)
MILVUS_URI=${MILVUS_URI-http://milvus-standalone:19530}
# MILVUS_TOKEN=
MILVUS_USER=${MILVUS_USER-root}
MILVUS_PASSWORD=${MILVUS_PASSWORD-Milvus}
# MILVUS_ANALYZER_PARAMS=
MILVUS_DATABASE=${MILVUS_DATABASE-default}
# MILVUS_ENABLE_HYBRID_SEARCH=False
