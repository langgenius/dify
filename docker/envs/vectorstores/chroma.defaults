# Defaults for chroma. Copy this file to chroma.env to customize it.
# Edit the settings below in the copy; docker/.env takes precedence.
# Optional application settings are commented to retain their application defaults.

# CHROMA_DATABASE=default_database
# CHROMA_AUTH_PROVIDER=chromadb.auth.token_authn.TokenAuthClientProvider
# CHROMA_AUTH_CREDENTIALS=
# CHROMA_HOST=127.0.0.1
# CHROMA_PORT=8000
# CHROMA_TENANT=default_tenant
CHROMA_SERVER_AUTHN_CREDENTIALS=${CHROMA_SERVER_AUTHN_CREDENTIALS:-difyai123456}
CHROMA_SERVER_AUTHN_PROVIDER=${CHROMA_SERVER_AUTHN_PROVIDER:-chromadb.auth.token_authn.TokenAuthenticationServerProvider}
CHROMA_IS_PERSISTENT=${CHROMA_IS_PERSISTENT:-TRUE}

# Container variable mappings; keep these expressions unchanged in the copy.
IS_PERSISTENT=${CHROMA_IS_PERSISTENT:-TRUE}
