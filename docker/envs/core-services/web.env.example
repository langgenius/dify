# ------------------------------
# Web Configuration
# ------------------------------

# Essential settings are defined in docker/.env.example.
# Set their local overrides in docker/.env instead of this file.

SENTRY_DSN=
WORKFLOW_GENERATION_TIMEOUT_MS=180000
ALLOW_INLINE_STYLES=false
# Example: ()!*&（）！＊＆－。.;；+=—
MARKDOWN_FORM_FIELD_NAME_EXTRA_CHARS=
# Maximum length of Markdown form field names.
MARKDOWN_FORM_FIELD_NAME_MAX_LENGTH=128
COOKIEYES_SITE_KEY=
NEXT_PUBLIC_ENABLE_FEATURE_PREVIEW=true
# Show Access Token settings to workspace owners. Disabled by default.
NEXT_PUBLIC_ENABLE_ACCESS_TOKEN=false
NEXT_PUBLIC_ENABLE_AGENT_V2_IN_CHATFLOW=false
