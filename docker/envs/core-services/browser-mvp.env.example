# Optional single-user Browser MVP overlay. Not required by default Dify deployment.
# docker/browser-mvp/scripts/prepare.py writes these deployment choices to the
# dedicated checkout's docker/.env because Compose needs them for interpolation.
MVP_API_PORT=15011
MVP_FIXTURE_PORT=16091
MVP_NOVNC_PORT=16090
MVP_HOST_CDP_PORT=19223
# Set by prepare from the pinned source commit, not a mutable release alias.
# MVP_SOURCE_TAG=
# The standalone browser JSON config uses Compose DNS, e.g. http://browser:9223.
# Mock verification code is generated by prepare; never use a production OTP here.
# DEMO_VERIFICATION_CODE=
