# Optional self-hosted end-user upload policy; zero disables a dimension.
# Copy into the environment of ALL API/worker processes that can upload files.
# Drain upload writers before enabling, changing, or disabling this policy.
# Limits apply independently to each workspace, not to the deployment total.
# Apply database migrations first. See docs/WORKSPACE_UPLOAD_QUOTA.md.
WORKSPACE_UPLOAD_QUOTA_BYTES=0
WORKSPACE_UPLOAD_QUOTA_FILES=0
