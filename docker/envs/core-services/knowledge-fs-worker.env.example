# Dedicated KnowledgeFS Celery roles use the same API image, broker and broker namespace as Dify.
# This file is loaded after knowledge-fs.env (the KnowledgeFS database/parser/model settings).
# Root docker/.env overrides both. Do not point DATABASE_URL at the Dify application database.
# Cutover requires KNOWLEDGE_BACKGROUND_EXECUTION=celery and
# KNOWLEDGE_FS_BACKGROUND_WORKER_ENABLED=true in root docker/.env, plus the
# knowledge-fs-celery Compose profile and an updated API/worker/worker_beat image.
KNOWLEDGE_FS_BACKGROUND_ENGINE_PATH=/app/knowledge-fs/celery-worker.mjs
KNOWLEDGE_FS_BACKGROUND_TASK_TIMEOUT_SECONDS=7200
# Broker delivery owns queued work. Leave ample time before an unclaimed outbox is republished;
# database lease expiry and checkpoints still own recovery of work that started executing.
KNOWLEDGE_DOCUMENT_COMPILATION_OUTBOX_VISIBILITY_MS=10800000
# These limits are PER CELERY CHILD, not per Pod. Increase replicas/concurrency together with
# parser capacity and model quotas; native PDF/Office work still uses the dedicated parser.
KNOWLEDGE_DOCUMENT_MATERIALIZATION_MAX_CONCURRENCY=2
KNOWLEDGE_MODEL_RUNTIME_GLOBAL_CONCURRENCY=16
KNOWLEDGE_PDF_RASTERIZER=poppler
