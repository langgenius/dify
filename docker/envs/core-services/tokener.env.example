# Optional managed Tokener billing settings. Copy the required values into
# docker/.env or envs/core-services/shared.env; this file is a reference only.
# Keep admission disabled until Billing, the plugin, and mappings are configured.
TOKENER_NEW_TENANT_COHORT_ENABLED=false
TOKENER_NEW_TENANT_BOOTSTRAP_ENABLED=false
TOKENER_BILLING_API_URL=
TOKENER_PLUGIN_UNIQUE_IDENTIFIER=
TOKENER_PLUGIN_INSTALL_SOURCE=marketplace
TOKENER_PROVIDER_NAME=langgenius/tokener/tokener
# Choose a model actually declared by the selected plugin and upstream catalog.
TOKENER_DEFAULT_LLM_MODEL=gpt-4o-mini
TOKENER_ENDPOINT_URL=
ENABLE_TOKENER_BOOTSTRAP_RECOVERY_TASK=true
TOKENER_BOOTSTRAP_RECOVERY_TASK_INTERVAL=5
TOKENER_BOOTSTRAP_RECOVERY_BATCH_SIZE=100
# Explicitly selected legacy tenants retain their original provider/App setup.
# Empty allowlist or registry denies admission; active tenants never roll back.
TOKENER_LEGACY_MIGRATION_ENABLED=false
TOKENER_LEGACY_MIGRATION_ALLOWLIST=
TOKENER_LEGACY_MODEL_MAPPING_JSON=[]
# Optional bounded read-only registry file, merged without replacing existing revisions.
TOKENER_LEGACY_MODEL_MAPPING_FILE=
# Exact revision/plugin/catalog evidence only; an empty value keeps strict source checks.
TOKENER_LEGACY_SOURCE_CAPABILITIES_JSON=[]
# Explicit source retirements are revision-scoped readiness policy, never a runtime fallback.
TOKENER_LEGACY_RETIRED_MODELS_JSON=[]
# Recovery remains independent of new migration admission.
ENABLE_TOKENER_MIGRATION_RECOVERY_TASK=false
