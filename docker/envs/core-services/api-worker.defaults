# BAIDU_VECTOR_DB_DATABASE=dify
# BAIDU_VECTOR_DB_SHARD=1
# BAIDU_VECTOR_DB_REPLICAS=3
# BAIDU_VECTOR_DB_INVERTED_INDEX_ANALYZER=DEFAULT_ANALYZER
