# Common API and worker configuration, including Beat. Copy this file to api-worker.env to customize it.
# Edit the copy; docker/.env takes precedence. Existing shared.env files remain supported.
# If both override files exist, api-worker.env takes precedence over shared.env.
# Active assignments preserve Docker defaults and explicit overrides, including empty values.
# Optional application/provider settings are commented examples: uncomment only what you need.
# Do not uncomment empty values or placeholders unless you intend to set them.
# Remove accidental empty overrides (especially CELERY_WORKER_AMOUNT=) to restore defaults.
# API process settings: api.defaults. Worker process settings: worker.defaults.
# Sentry mappings: api.defaults and worker.defaults. Web and plugin-daemon settings stay in their files.
# Shared secrets and token lifetimes: copy ../security.env.example to ../security.env.
# Set COMPOSE_PROFILES in docker/.env; Compose reads it before service env files.
# Set EXPOSE_NGINX_PORT in docker/.env; Compose reads published ports before service env files.
# Set EXPOSE_NGINX_SSL_PORT in docker/.env; Compose reads published ports before service env files.
# Set EXPOSE_PLUGIN_DEBUGGING_HOST in docker/.env; the API and daemon must use the published address.
# Set EXPOSE_PLUGIN_DEBUGGING_PORT in docker/.env; the API and daemon must use the published port.

# ------------------------------
# URLs, deployment and locale
# ------------------------------
# CONSOLE_WEB_URL=
# SERVICE_API_URL=
TRIGGER_URL=${TRIGGER_URL-http://localhost}
# APP_WEB_URL=
# FILES_URL=
# INTERNAL_FILES_URL=
ENDPOINT_URL_TEMPLATE=${ENDPOINT_URL_TEMPLATE-http://localhost/e/{hook_id}}
# DEPLOY_ENV=PRODUCTION
# DEPLOYMENT_EDITION=COMMUNITY
MIGRATION_ENABLED=${MIGRATION_ENABLED-true}
# LANG=C.UTF-8
# LC_ALL=C.UTF-8
# PYTHONIOENCODING=utf-8
# CHECK_UPDATE_URL=https://updates.dify.ai
# OPENAI_API_BASE=https://api.openai.com/v1
# Nacos remote settings source HTTP timeouts (seconds).
# Bound how long requests to the Nacos endpoint wait before failing, so a slow or
# unresponsive Nacos server cannot stall API startup or token refresh.
# DIFY_ENV_NACOS_REQUEST_TIMEOUT=10.0
# DIFY_ENV_NACOS_CONNECT_TIMEOUT=3.0

# ------------------------------
# System features and account access
# ------------------------------
# MARKETPLACE_ENABLED=true
# ENABLE_EMAIL_CODE_LOGIN=false
# EMAIL_CODE_LOGIN_TOKEN_EXPIRY_MINUTES=5
# EMAIL_CODE_LOGIN_MAX_ATTEMPTS=5
# ENABLE_EMAIL_PASSWORD_LOGIN=true
# ENABLE_SOCIAL_OAUTH_LOGIN=false
# Remove `collaboration` from COMPOSE_PROFILES to stop the dedicated websocket service.
# ENABLE_COLLABORATION_MODE=true
# ALLOW_REGISTER=false
# ALLOW_CREATE_WORKSPACE=false
# ENABLE_CHANGE_EMAIL=true
# ENABLE_TRIAL_APP=false
# ENABLE_EXPLORE_BANNER=false
# ENABLE_LEARN_APP=true
# ENABLE_STEP_BY_STEP_TOUR=false
# ENABLE_SKILL=true
# RBAC_ENABLED=false
# ENABLE_LICENSE_EXPIRY_NOTICE=true
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30
# INVITE_EXPIRY_HOURS=72
# WEB_API_CORS_ALLOW_ORIGINS=*
CONSOLE_CORS_ALLOW_ORIGINS=${CONSOLE_CORS_ALLOW_ORIGINS-*}
# COOKIE_DOMAIN=

# ------------------------------
# API and Celery Docker defaults
# ------------------------------
# Unset values use these Docker defaults; an explicit empty value remains an override.
SERVER_WORKER_CLASS=${SERVER_WORKER_CLASS-gevent}
GUNICORN_TIMEOUT=${GUNICORN_TIMEOUT-360}
CELERY_WORKER_AMOUNT=${CELERY_WORKER_AMOUNT-4}

# ------------------------------
# Celery broker and KnowledgeFS dispatch
# ------------------------------
# Broker URL defaults/mappings live in api.defaults, worker.defaults and worker-beat.defaults.
# Set a common CELERY_BROKER_URL override in api-worker.env or docker/.env for every producer/consumer.
# Optional long-running KnowledgeFS Celery rollout: set identically in every API, worker and Beat
# process sharing this Redis broker. It must exceed the KnowledgeFS hard task limit (7230s by
# default). Keep unset to preserve Celery's existing default when this rollout is disabled.
# CELERY_BROKER_VISIBILITY_TIMEOUT=10800
# CELERY_TASK_ANNOTATIONS=null
# CELERY_SENTINEL_PASSWORD=
# CELERY_BACKEND=redis
# CELERY_USE_SENTINEL=false
# CELERY_SENTINEL_MASTER_NAME=
# CELERY_SENTINEL_SOCKET_TIMEOUT=0.1
# KNOWLEDGE_FS_BACKGROUND_WORKER_ENABLED=true
# KNOWLEDGE_FS_BACKGROUND_POLL_INTERVAL_SECONDS=5

# ------------------------------
# Database and Redis connections
# ------------------------------
DB_HOST=${DB_HOST-db_postgres}
DB_USERNAME=${DB_USERNAME-postgres}
DB_PASSWORD=${DB_PASSWORD-difyai123456}
DB_PORT=${DB_PORT-5432}
REDIS_HOST=${REDIS_HOST-redis}
REDIS_PASSWORD=${REDIS_PASSWORD-difyai123456}
REDIS_PORT=${REDIS_PORT-6379}
REDIS_KEEPALIVE=${REDIS_KEEPALIVE-true}

# ------------------------------
# Logging, traces and telemetry
# ------------------------------
# LOG_LEVEL=INFO
# LOG_OUTPUT_FORMAT=text
LOG_FILE=${LOG_FILE-/app/logs/server.log}
# LOG_FILE_MAX_SIZE=20
# LOG_FILE_BACKUP_COUNT=5
LOG_DATEFORMAT=${LOG_DATEFORMAT-%Y-%m-%d %H:%M:%S}
# LOG_TZ=UTC
# DEBUG=false
# FLASK_DEBUG=false
# ENABLE_REQUEST_LOGGING=False
# Application-level Agent tracing; also enable the collector in dify-agent.env.
# OPS_AGENT_TRACE_ENABLED=false
# ENABLE_APPLICATION_TRACE_RECONCILE_TASK=true
# Shared by API, workers, and Beat. Keep separate from legacy ops_trace during upgrades.
# OPS_TRACE_QUEUE=ops_trace_v2
# Attempts to send one trace while its provider is temporarily unavailable.
# OPS_TRACE_EXPORT_MAX_ATTEMPTS=6
# Daily cleanup of trace payloads an interrupted delivery left in storage.
# ENABLE_TRACE_PAYLOAD_SWEEP_TASK=true
# ENABLE_OTEL=false
# OTLP_TRACE_ENDPOINT=
# OTLP_METRIC_ENDPOINT=
# OTLP_BASE_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=
# OTEL_EXPORTER_TYPE=otlp
# OTEL_SAMPLING_RATE=0.1
# OTEL_BATCH_EXPORT_SCHEDULE_DELAY=5000
# OTEL_MAX_QUEUE_SIZE=2048
# OTEL_MAX_EXPORT_BATCH_SIZE=512
# OTEL_METRIC_EXPORT_INTERVAL=60000
# OTEL_BATCH_EXPORT_TIMEOUT=10000
# OTEL_METRIC_EXPORT_TIMEOUT=30000

