# Defaults for nginx. Copy this file to nginx.env to customize it.
# Edit the settings below in the copy; docker/.env takes precedence.
# Optional application settings are commented to retain their application defaults.

NGINX_SERVER_NAME=${NGINX_SERVER_NAME:-_}
# Supply certificates in docker/nginx/ssl or enable the Certbot challenge before enabling HTTPS.
NGINX_HTTPS_ENABLED=${NGINX_HTTPS_ENABLED:-false}
# Set NGINX_PORT in docker/.env; Compose needs it before loading service files.
# Set NGINX_SSL_PORT in docker/.env; Compose needs it before loading service files.
NGINX_SSL_CERT_FILENAME=${NGINX_SSL_CERT_FILENAME:-dify.crt}
NGINX_SSL_CERT_KEY_FILENAME=${NGINX_SSL_CERT_KEY_FILENAME:-dify.key}
NGINX_SSL_PROTOCOLS=${NGINX_SSL_PROTOCOLS:-TLSv1.2 TLSv1.3}
NGINX_WORKER_PROCESSES=${NGINX_WORKER_PROCESSES:-auto}
NGINX_CLIENT_MAX_BODY_SIZE=${NGINX_CLIENT_MAX_BODY_SIZE:-100M}
NGINX_KEEPALIVE_TIMEOUT=${NGINX_KEEPALIVE_TIMEOUT:-65}
NGINX_PROXY_READ_TIMEOUT=${NGINX_PROXY_READ_TIMEOUT:-3600s}
NGINX_PROXY_SEND_TIMEOUT=${NGINX_PROXY_SEND_TIMEOUT:-3600s}
NGINX_ENABLE_CERTBOT_CHALLENGE=${NGINX_ENABLE_CERTBOT_CHALLENGE:-false}
NGINX_SOCKET_IO_UPSTREAM=${NGINX_SOCKET_IO_UPSTREAM:-api_websocket:5001}
CERTBOT_DOMAIN=${CERTBOT_DOMAIN:-}
# Caddy only (docker-compose.caddy.yaml): addresses or CIDR ranges of the proxies in
# front of Dify, separated by spaces. Their client-IP header is trusted; empty trusts none.
# See README.md#client-ip-and-trusted-proxies before setting it.
CADDY_TRUSTED_PROXIES=${CADDY_TRUSTED_PROXIES:-}
# Header carrying the visitor address from those proxies, e.g. CF-Connecting-IP for Cloudflare.
CADDY_CLIENT_IP_HEADERS=${CADDY_CLIENT_IP_HEADERS:-X-Forwarded-For}
# Caddy only: public domain names, separated by spaces, for which Caddy obtains and renews
# certificates itself (no Certbot). Requires EXPOSE_NGINX_PORT=80 and EXPOSE_NGINX_SSL_PORT=443
# reachable from the internet. Leave NGINX_HTTPS_ENABLED=false when using it.
CADDY_AUTO_HTTPS_DOMAINS=${CADDY_AUTO_HTTPS_DOMAINS:-}
# ACME directory for those certificates; defaults to Let's Encrypt. For trials, use
# https://acme-staging-v02.api.letsencrypt.org/directory to avoid rate limits.
CADDY_ACME_CA=${CADDY_ACME_CA:-}
