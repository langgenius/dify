# Please do not edit this file directly. Change the NGINX_* settings instead
# (envs/infrastructure/nginx.env); docker-entrypoint.sh translates them.
#
# Routes mirror nginx/conf.d/default.conf.template one for one.
{
	# The admin API listens on the container's loopback only; `reload` uses it.
	admin localhost:2019
	# Certificates come from the operator or Certbot, as with Nginx.
	auto_https off
	servers {
		protocols h1 h2
		timeouts {
			idle {$DIFY_PROXY_IDLE_TIMEOUT}
		}
	}
}

(dify_upstream) {
	reverse_proxy {args[0]} {
		# Nginx: proxy_buffering off. Streams (SSE, chunked) flush immediately.
		flush_interval -1
		# Like the Nginx map: the port from the Host header, so the API's
		# ProxyFix(x_port=1) keeps the external port. ProxyFix ignores an empty value.
		header_up X-Forwarded-Port {http.request.port}
		# The API trusts X-Forwarded-For and X-Forwarded-Port only.
		header_up -X-Forwarded-Host
		header_up -Via
		header_down -Server
		transport http {
			# Not read_timeout: on a reused upstream connection Go retries a GET that
			# hit it, so the upstream would receive the request twice.
			response_header_timeout {$DIFY_PROXY_READ_TIMEOUT}
			write_timeout {$DIFY_PROXY_SEND_TIMEOUT}
		}
	}
}

(dify_routes) {
	log

	request_body {
		max_size {$DIFY_PROXY_MAX_BODY_SIZE}
	}

	import acme-challenge-{$DIFY_PROXY_ACME_CHALLENGE}.caddy

	# Nginx prefix locations are case-sensitive; Caddy's path matcher is not.
	@api path_regexp ^/(console/api|api|v1|openapi|files|mcp|triggers|callbacks/human-input/v2/im/)
	handle @api {
		import dify_upstream api:5001
	}

	@socket_io path_regexp ^/socket\.io/
	handle @socket_io {
		import dify_upstream {$DIFY_PROXY_SOCKET_IO_UPSTREAM}
	}

	# Nginx redirects "/e" to "/e/" for its "location /e/" block.
	redir /e /e/ 301

	@plugin_endpoint path_regexp ^/e/
	handle @plugin_endpoint {
		# Nginx: $scheme://$host$request_uri ($host has no port; IPv6 keeps brackets).
		map {http.request.host} {dify_hook_host} {
			~^(.*:.*)$ "[${1}]"
			default {http.request.host}
		}
		request_header Dify-Hook-Url {scheme}://{dify_hook_host}{uri}
		import dify_upstream plugin_daemon:5002
	}

	handle {
		import dify_upstream web:3000
	}

	header -Via
}

http://:{$NGINX_PORT} {
	import dify_routes
}

import https-{$DIFY_PROXY_HTTPS}.caddy
