# Only settings requiring manual configuration belong in this file.
# Application and Docker defaults are loaded automatically; do not repeat them here.
# Copy this file to .env, then select the services for your deployment.
# Optional overrides and provider settings are documented in envs/**/*.env.example.
# Values in .env take precedence over the matching envs/*.env files.

# Compose requires an explicit selection of the bundled database, vector store,
# and websocket service. Match these profiles to your DB_TYPE and VECTOR_STORE
# overrides when using different providers; omit services hosted externally.
COMPOSE_PROFILES=weaviate,postgresql,collaboration
