# Please do not directly edit this file. Instead, modify the .env variables related to NGINX configuration.

user  nginx;
worker_processes  ${NGINX_WORKER_PROCESSES};

error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;


events {
    worker_connections  1024;
}


http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Preserve the browser-facing authority, including Docker's exposed port.
    map $http_host $dify_request_host {
        default $http_host;
        ""      $host;
    }

    # ProxyFix must not replace an external Host port with the internal listener port.
    # With a portless Host, keep its authority and discard caller-supplied ports.
    # Hostless HTTP/1.0 requests retain the existing listener-port fallback.
    map $http_host $dify_request_port {
        default "";
        ""      $server_port;
        ~^(?:\[[^]]+\]|[^:]+):(?<dify_host_port>[0-9]+)$ $dify_host_port;
    }

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    #tcp_nopush     on;

    keepalive_timeout  ${NGINX_KEEPALIVE_TIMEOUT};

    #gzip  on;
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    include /etc/nginx/conf.d/*.conf;
}
