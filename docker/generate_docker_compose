#!/usr/bin/env python3
import os
import re
import sys

# Variables that exist only for Docker Compose orchestration and must NOT be
# injected into containers as environment variables.
SHARED_ENV_EXCLUDE = frozenset(
    [
        # Docker Compose profile selection
        "COMPOSE_PROFILES",
        # Worker health check orchestration flags (consumed by docker-compose,
        # not by the application running inside the container)
        "COMPOSE_WORKER_HEALTHCHECK_DISABLED",
        "COMPOSE_WORKER_HEALTHCHECK_INTERVAL",
        "COMPOSE_WORKER_HEALTHCHECK_TIMEOUT",
    ]
)


def parse_env_example(file_path):
    """
    Parses the .env.example file and returns a dictionary with variable names as keys and default values as values.
    """
    env_vars = {}
    with open(file_path, "r", encoding="utf-8") as f:
        for line_number, line in enumerate(f, 1):
            line = line.strip()
            # Ignore empty lines and comments
            if not line or line.startswith("#"):
                continue
            # Use regex to parse KEY=VALUE
            match = re.match(r"^([^=]+)=(.*)$", line)
            if match:
                key = match.group(1).strip()
                value = match.group(2).strip()
                # Remove possible quotes around the value
                if (value.startswith('"') and value.endswith('"')) or (
                    value.startswith("'") and value.endswith("'")
                ):
                    value = value[1:-1]
                env_vars[key] = value
            else:
                print(f"Warning: Unable to parse line {line_number}: {line}")
    return env_vars


def generate_shared_env_block(env_vars, anchor_name="shared-api-worker-env"):
    """
    Generates a shared environment variables block as a YAML string.
    """
    lines = [f"x-shared-env: &{anchor_name}"]
    for key, default in env_vars.items():
        if key in SHARED_ENV_EXCLUDE:
            continue
        # If default value is empty, use ${KEY:-}
        if default == "":
            lines.append(f"  {key}: ${{{key}:-}}")
        else:
            # If default value contains special characters, wrap it in quotes
            if re.search(r"[:\s]", default):
                default = f"{default}"
            lines.append(f"  {key}: ${{{key}:-{default}}}")
    return "\n".join(lines)


def create_env_files_from_example(env_example_path):
    """
    Creates actual env files from .env.example by copying the categorized .env.example files.
    This allows docker-compose to use env_file references.
    Supports per-module structure with subdirectories.
    """
    base_dir = os.path.dirname(os.path.abspath(env_example_path))
    root_env_file = os.path.join(base_dir, ".env")
    if not os.path.exists(root_env_file):
        with open(env_example_path, "r", encoding="utf-8") as src, open(
            root_env_file, "w", encoding="utf-8", newline="\n"
        ) as dst:
            dst.write(src.read())
        print(f"Created {root_env_file}")
    else:
        print(f"{root_env_file} already exists, skipping")

    envs_dir = os.path.join(base_dir, "envs")
    if not os.path.isdir(envs_dir):
        print(f"No envs directory found at {envs_dir}, skipping split env files")
        return []

    created_files = []
    # Walk through all .env.example files in subdirectories
    for root, dirs, files in os.walk(envs_dir):
        for file in files:
            if file.endswith('.env.example'):
                example_file = os.path.join(root, file)
                env_file = example_file.replace('.env.example', '.env')

                if os.path.exists(env_file):
                    print(f"{env_file} already exists, skipping")
                    continue

                # Copy .example to actual file
                with open(example_file, "r", encoding="utf-8") as src, open(
                    env_file, "w", encoding="utf-8", newline="\n"
                ) as dst:
                    dst.write(src.read())
                created_files.append(env_file)
                print(f"Created {env_file}")
    
    return created_files


def strip_x_build_blocks(template_content):
    """
    Removes `x-build:` extension blocks (and their nested `context`/
    `dockerfile` lines) from the template content. `x-build` is only meant to feed
    docker-compose.source.yaml generation; docker-compose.yaml must not
    carry it, even though Compose would otherwise silently ignore it.
    """
    lines = template_content.split("\n")
    output_lines = []
    skipping = False

    for line in lines:
        stripped = line.strip()
        indent = len(line) - len(line.lstrip(" "))

        if indent == 4 and stripped == "x-build:":
            skipping = True
            continue

        if skipping:
            if indent == 6 and (stripped.startswith("context:") or stripped.startswith("dockerfile:")):
                continue
            skipping = False

        output_lines.append(line)

    return "\n".join(output_lines)


def insert_shared_env(template_path, output_path, header_comments):
    """
    Copies the template file to output path with header comments.
    The template now uses env_file references instead of a huge YAML anchor.
    `x-build` extension blocks are stripped: docker-compose.yaml only ships
    published images and never builds from source.
    """
    with open(template_path, "r", encoding="utf-8") as f:
        template_content = f.read()

    template_content = strip_x_build_blocks(template_content)

    # Prepare the final content with header comments
    final_content = f"{header_comments}\n{template_content}"

    with open(output_path, "w", encoding="utf-8", newline="\n") as f:
        f.write(final_content)
    print(f"Generated {output_path}")


def extract_build_services(template_path):
    """
    Scans docker-compose-template.yaml for top-level services that declare an
    `x-build:` extension field (a per-service `context`/`dockerfile` pair).

    `x-build` is used instead of the real `build` key so that
    docker-compose.yaml (generated from this same template) keeps shipping
    published images unchanged: Compose ignores unknown `x-` fields, so
    `x-build` has no effect there. It exists purely as the single source of
    truth from which docker-compose.source.yaml is generated, guaranteeing
    that the two files can never drift apart.

    Returns an ordered list of (service_name, context, dockerfile) tuples.
    """
    with open(template_path, "r", encoding="utf-8") as f:
        lines = f.readlines()

    services = []
    current_service = None
    in_x_build = False
    context = None
    dockerfile = None

    def line_indent(line):
        return len(line) - len(line.lstrip(" "))

    for line in lines:
        stripped = line.rstrip("\n")
        if not stripped.strip():
            continue

        indent = line_indent(stripped)

        # Top-level service definitions are indented by exactly 2 spaces,
        # e.g. "  api:".
        service_match = re.match(r"^  ([a-zA-Z0-9_-]+):\s*$", stripped)
        if indent == 2 and service_match:
            current_service = service_match.group(1)
            in_x_build = False
            context, dockerfile = None, None
            continue

        if current_service is None:
            continue

        if indent == 4 and stripped.strip() == "x-build:":
            in_x_build = True
            continue

        if in_x_build and indent == 6:
            context_match = re.match(r"^\s*context:\s*(\S+)\s*$", stripped)
            dockerfile_match = re.match(r"^\s*dockerfile:\s*(\S+)\s*$", stripped)
            if context_match:
                context = context_match.group(1)
            elif dockerfile_match:
                dockerfile = dockerfile_match.group(1)
            continue

        if indent <= 4:
            # Left the x-build block (either a sibling key of the service,
            # or a new service/section entirely).
            if in_x_build and context and dockerfile:
                services.append((current_service, context, dockerfile))
            in_x_build = False

    # Flush a trailing x-build block if the file ended immediately after it.
    if in_x_build and context and dockerfile:
        services.append((current_service, context, dockerfile))

    return services


def generate_docker_compose_source(template_path, output_path, docker_dir):
    """
    Generates docker-compose.source.yaml from the `x-build` extension fields
    declared in docker-compose-template.yaml. Also validates that every
    referenced Dockerfile actually exists, so a missing/renamed Dockerfile
    fails fast at generation time instead of silently drifting.
    """
    services = extract_build_services(template_path)

    if not services:
        print(f"Warning: No x-build services found in {template_path}, skipping {output_path}")
        return

    missing = []
    for service_name, context, dockerfile in services:
        dockerfile_path = os.path.normpath(os.path.join(docker_dir, context, dockerfile))
        if not os.path.isfile(dockerfile_path):
            missing.append(f"{service_name}: {dockerfile_path}")

    if missing:
        print("Error: docker-compose-template.yaml references Dockerfiles that do not exist:")
        for entry in missing:
            print(f"  - {entry}")
        sys.exit(1)

    lines = ["services:"]
    for service_name, context, dockerfile in services:
        lines.append(f"  {service_name}:")
        lines.append('    image: ""')
        lines.append("    build:")
        lines.append(f"      context: {context}")
        lines.append(f"      dockerfile: {dockerfile}")

    with open(output_path, "w", encoding="utf-8", newline="\n") as f:
        f.write("\n".join(lines) + "\n")
    print(f"Generated {output_path}")


def main():
    base_dir = os.path.dirname(os.path.abspath(__file__))
    env_example_path = os.path.join(base_dir, ".env.example")
    template_path = os.path.join(base_dir, "docker-compose-template.yaml")
    output_path = os.path.join(base_dir, "docker-compose.yaml")
    source_output_path = os.path.join(base_dir, "docker-compose.source.yaml")

    # Define header comments to be added at the top of docker-compose.yaml
    header_comments = (
        "# ==================================================================\n"
        "# WARNING: This file is auto-generated by generate_docker_compose\n"
        "# Do not modify this file directly. Instead, update the .env.example\n"
        "# or docker-compose-template.yaml and regenerate this file.\n"
        "# ==================================================================\n"
    )

    # Check if required files exist
    for path in [env_example_path, template_path]:
        if not os.path.isfile(path):
            print(f"Error: File {path} does not exist.")
            sys.exit(1)

    # Create env files from categorized .env.example files
    # These files are used by docker-compose's env_file directive
    # This ensures .env files exist even in CI/CD environments
    create_env_files_from_example(env_example_path)

    # Copy template to output with header comments
    # The template now uses env_file references instead of a huge YAML anchor
    insert_shared_env(template_path, output_path, header_comments)

    # Generate docker-compose.source.yaml from the same template, so it can
    # never drift from the services/Dockerfiles that actually exist.
    generate_docker_compose_source(template_path, source_output_path, base_dir)


if __name__ == "__main__":
    main()
