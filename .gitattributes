# Ensure that .sh scripts use LF as line separator, even if they are checked out
# to Windows(NTFS) file-system, by a user of Docker for Windows.
# These .sh scripts will be run from the Container after `docker compose up -d`.
# If they appear to be CRLF style, Dash from the Container will fail to execute
# them.

*.sh      text eol=lf

# Codegen output must stay byte-identical across platforms so
# `pnpm tree:check` in CI does not trip on CRLF rewrites.
*.generated.ts  text eol=lf

# The billing client is generated from the billing service OpenAPI; its
# `--check` compares bytes, so keep LF. transport.py and __init__.py are hand-written.
/api/services/billing_client/billing.openapi.json  text eol=lf
/api/services/billing_client/saas.openapi.json     text eol=lf
/api/services/billing_client/billing.py            text eol=lf
/api/services/billing_client/saas.py               text eol=lf

# Skill scripts run on every platform, so keep LF line endings.
/skills/**      text=auto eol=lf

# Collapse generated files in GitHub diffs and exclude them from language stats.
/packages/contracts/generated/**  linguist-generated
/api/openapi/markdown/**          linguist-generated
*.generated.ts                    linguist-generated
/oxlint-suppressions.json         linguist-generated
/api/services/billing_client/billing.openapi.json  linguist-generated
/api/services/billing_client/saas.openapi.json     linguist-generated
/api/services/billing_client/billing.py            linguist-generated
/api/services/billing_client/saas.py               linguist-generated
